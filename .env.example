# Runtime environment: development | production | test
NODE_ENV=development

# API
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres (host port matches docker-compose.yaml)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/flagkit

# Redis (host port matches docker-compose.yaml). Only needed while CACHE_L2_ENABLED is true.
REDIS_URL=redis://localhost:6380

# Caching. All default to true. Each level is on only if CACHE_ENABLED is also true.
#   CACHE_ENABLED=false     no caching, every request reads Postgres (e.g. a demo without Redis)
#   CACHE_L1_ENABLED=false  skip the in-memory cache
#   CACHE_L2_ENABLED=false  skip Redis: no Redis connection, and other servers aren't told to drop
#                           their in-memory copies, so changes can take up to the L1 TTL (10-30s)
CACHE_ENABLED=true
CACHE_L1_ENABLED=true
CACHE_L2_ENABLED=true

# JWT signing secret (min 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Pepper for HMAC-hashing project API keys (min 32 chars). Generate with: openssl rand -hex 32
# Keep it out of the database. Changing it invalidates every stored API key.
API_KEY_PEPPER=change-me-to-a-random-string-of-at-least-32-chars

# Browser origins allowed to call the API with credentials (comma-separated, no trailing slash).
# Leave empty to disallow cross-origin requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
