# Runtime environment: development | production | test
NODE_ENV=development

# API
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres (host port matches docker-compose.yaml)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/flagkit

# Redis (host port matches docker-compose.yaml)
REDIS_URL=redis://localhost:6380

# JWT signing secret (min 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
